# Shared with the Google Apps Script WEBHOOK_SECRET property.
# Generate a long random value and configure it only in trusted server/script settings.
GOOGLE_SHEETS_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Process exactly one repository at a time; additional submissions remain queued.
EVALUATION_CONCURRENCY=1

# Optional GitHub API token for higher repository-analysis rate limits.
GITHUB_TOKEN=
